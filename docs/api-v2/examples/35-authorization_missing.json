{
  "name": "authorization missing",
  "description": "A request without credentials is refused.",
  "fixtures": {
    "catalogue": "standard",
    "assessments": [
      {
        "name": "main",
        "provider": "aws",
        "exit_strategy": "repatriation",
        "assessment_type": 2,
        "scope_key": null
      }
    ],
    "keys": [
      {
        "name": "assessment_key",
        "kind": "assessment",
        "assessment": "main"
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/api/v2/whoami",
    "headers": {}
  },
  "expect": {
    "status": 401,
    "headers_present": [
      "X-Request-ID"
    ],
    "body_subset": {
      "object": "error",
      "api_version": "2",
      "error": {
        "code": "unauthenticated"
      }
    },
    "exists": [
      "/error/message",
      "/error/request_id"
    ]
  }
}
