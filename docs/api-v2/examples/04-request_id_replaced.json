{
  "name": "request id replaced",
  "description": "A client X-Request-ID that does not match the pattern is replaced, and the response always carries one.",
  "fixtures": {
    "catalogue": "standard",
    "assessments": [
      {
        "name": "main",
        "provider": "aws",
        "exit_strategy": "repatriation",
        "assessment_type": 2,
        "scope_key": null
      }
    ],
    "keys": [
      {
        "name": "assessment_key",
        "kind": "assessment",
        "assessment": "main"
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/api/v2/whoami",
    "headers": {
      "Authorization": "Bearer {{assessment_key}}",
      "X-Request-ID": "bad id!"
    }
  },
  "expect": {
    "status": 200,
    "headers_present": [
      "X-Request-ID"
    ],
    "headers_differ": {
      "X-Request-ID": "bad id!"
    },
    "body_subset": {
      "object": "whoami"
    }
  }
}
