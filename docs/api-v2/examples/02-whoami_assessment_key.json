{
  "name": "whoami assessment key",
  "description": "An assessment key is bound to its assessment and can only write syncs.",
  "fixtures": {
    "catalogue": "standard",
    "assessments": [
      {
        "name": "main",
        "provider": "aws",
        "exit_strategy": "repatriation",
        "assessment_type": 2,
        "scope_key": null
      }
    ],
    "keys": [
      {
        "name": "assessment_key",
        "kind": "assessment",
        "assessment": "main"
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/api/v2/whoami",
    "headers": {
      "Authorization": "Bearer {{assessment_key}}"
    }
  },
  "expect": {
    "status": 200,
    "headers_present": [
      "X-Request-ID"
    ],
    "body_subset": {
      "object": "whoami",
      "api_version": "2",
      "key": {
        "name": "assessment_key",
        "kind": "assessment",
        "scopes": [
          "syncs:write"
        ],
        "assessment_id": "{{main_id}}"
      }
    },
    "exists": [
      "/tenant/type",
      "/tenant/id",
      "/tenant/name",
      "/key/id",
      "/key/display",
      "/key/expires_at",
      "/warnings"
    ]
  }
}
