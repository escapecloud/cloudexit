{
  "name": "list assessments bad cursor",
  "description": "A cursor the host did not issue is refused.",
  "fixtures": {
    "catalogue": "standard",
    "assessments": [
      {
        "name": "main",
        "provider": "aws",
        "exit_strategy": "repatriation",
        "assessment_type": 2,
        "scope_key": null
      }
    ],
    "keys": [
      {
        "name": "reader_key",
        "kind": "account",
        "scopes": [
          "assessments:read"
        ]
      }
    ]
  },
  "request": {
    "method": "GET",
    "path": "/api/v2/assessments?cursor=not-a-cursor",
    "headers": {
      "Authorization": "Bearer {{reader_key}}"
    }
  },
  "expect": {
    "status": 422,
    "headers_present": [
      "X-Request-ID"
    ],
    "body_subset": {
      "object": "error",
      "api_version": "2",
      "error": {
        "code": "validation_failed",
        "details": [
          {
            "parameter": "cursor",
            "code": "invalid_format"
          }
        ]
      }
    },
    "exists": [
      "/error/message",
      "/error/request_id"
    ]
  }
}
