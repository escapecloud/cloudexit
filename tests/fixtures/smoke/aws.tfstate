{
  "version": 4,
  "terraform_version": "1.14.6",
  "serial": 1,
  "lineage": "00000000-0000-0000-0000-000000000000",
  "resources": [
    {
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "assets",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "region": "eu-central-1",
            "bucket": "example-assets",
            "arn": "arn:aws:s3:::example-assets"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_instance",
      "name": "web",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "availability_zone": "eu-central-1a",
            "arn": "arn:aws:ec2:eu-central-1:123456789012:instance/i-0123456789abcdef0"
          }
        },
        {
          "schema_version": 0,
          "attributes": {
            "availability_zone": "eu-central-1b",
            "arn": "arn:aws:ec2:eu-central-1:123456789012:instance/i-0123456789abcdef1"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_lambda_function",
      "name": "worker",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:lambda:eu-central-1:123456789012:function:example-worker"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_dynamodb_table",
      "name": "items",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:dynamodb:eu-central-1:123456789012:table/example-items"
          }
        }
      ]
    }
  ]
}
